int g_iteracoes;
float g_resultado_final;

void processa_dados(int valor_inicial);
int calcula_fatorial(int n);

int main(void) {
    int i;
    int fatorial_de_5;

    g_iteracoes = 0;
    fatorial_de_5 = calcula_fatorial(5);

    processa_dados(fatorial_de_5);
    
    return 0;
}


void processa_dados(int valor_inicial) {
    g_resultado_final = valor_inicial;

    while (g_iteracoes < 3) {
        if (g_resultado_final > 10) {
            g_resultado_final = g_resultado_final / 2.0;
        } else {
            g_resultado_final = g_resultado_final + 1.0;
        }
        g_iteracoes = g_iteracoes + 1;
    }
}

int calcula_fatorial(int n) {
    if (n == 0) {
        return 1;
    } else {
        return n * calcula_fatorial(n - 1);
    }
}